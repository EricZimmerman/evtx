<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <IsPackable>false</IsPackable>
    <Copyright>Eric Zimmerman</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="[7.2.2,8.0.0)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="Crc32.NET" Version="1.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\evtx\evtx.csproj" />
    <!-- CliTests run the built EvtxECmd.dll, which this copies next to the tests -->
    <ProjectReference Include="..\EvtxECmd\EvtxECmd.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="TestFiles/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../evtx/Maps/**" LinkBase="Maps" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
